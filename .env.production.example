# RealTrack Production Configuration

# Environment Configuration
# Copy this file to .env.local and fill in the actual values

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=your-access-token

# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database_name
PRODUCTION_DATABASE_URL=postgresql://prod-user:prod-pass@prod-host:5432/realtrack_prod
STAGING_DATABASE_URL=postgresql://stage-user:stage-pass@stage-host:5432/realtrack_stage

# Supabase Project IDs
PRODUCTION_SUPABASE_PROJECT_ID=your-production-project-id
STAGING_SUPABASE_PROJECT_ID=your-staging-project-id

# Mapbox Configuration
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-mapbox-public-token
PRODUCTION_MAPBOX_TOKEN=pk.your-production-mapbox-token

# Vercel Configuration
VERCEL_TOKEN=your-vercel-api-token
VERCEL_ORG_ID=your-vercel-organization-id
BUSINESS_VERCEL_PROJECT_ID=your-business-vercel-project-id
CUSTOMER_VERCEL_PROJECT_ID=your-customer-vercel-project-id

# Mobile App Configuration

# Android Signing
ANDROID_KEYSTORE_BASE64=base64-encoded-android-keystore-file
ANDROID_KEYSTORE_PASSWORD=your-android-keystore-password
ANDROID_KEY_ALIAS=your-android-key-alias
ANDROID_KEY_PASSWORD=your-android-key-password

# iOS Distribution
APPLE_ID=your-apple-developer-id@apple.com
APPLE_APP_SPECIFIC_PASSWORD=your-app-specific-password
APPLE_KEY_ID=your-apple-key-id
APPLE_ISSUER_ID=your-apple-issuer-id
MATCH_PASSWORD=your-match-password
APPLE_SIGNING_KEY=base64-encoded-ios-signing-key

# Firebase Configuration
FIREBASE_ANDROID_APP_ID=1:1234567890:android:com.realtrack.driver
FIREBASE_IOS_APP_ID=1:987654321:ios:com.realtrack.driver
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CONFIG_FILE=base64-encoded-firebase-config
FIREBASE_SERVICE_ACCOUNT=your-firebase-service-account-json

# Google Play Store
GOOGLE_PLAY_SERVICE_ACCOUNT=base64-encoded-google-play-service-account-json
GOOGLE_PLAY_PACKAGE_NAME=com.realtrack.driver

# Monitoring & Analytics

# Sentry
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ORG_SLUG=realtrack
SENTRY_PROJECT_SLUG=driver-app

# Slack Notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
SLACK_DEPLOYMENTS_CHANNEL=#deployments
SLACK_ALERTS_CHANNEL=#alerts
SLACK_MONITORING_CHANNEL=#monitoring

# Performance Monitoring
LHCI_GITHUB_APP_TOKEN=ghp_your-github-app-token
LHCI_SERVER_URL=https://your-lhci-server.com
LHCI_SERVER_TOKEN=your-lhci-server-token

# Monitoring Dashboard
MONITORING_API_URL=https://your-monitoring-api.com/api
MONITORING_TOKEN=your-monitoring-token
MONITORING_WEBHOOK_URL=https://your-monitoring-webhook.com/webhook

# SEO & Analytics
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
GOOGLE_TAG_MANAGER_ID=GTM-XXXXXXX
VERIFICATION_META_TAG=google-site-verification: your-verification-code

# CDN & Assets
ASSET_CDN_URL=https://your-cdn-url.com
ASSET_CDN_TOKEN=your-cdn-token

# Search Console
GOOGLE_SEARCH_CONSOLE_API_KEY=your-google-search-console-api-key

# Security
ENCRYPTION_KEY=your-32-character-encryption-key
JWT_SECRET=your-jwt-secret-key
API_SECRET_KEY=your-api-secret-key

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_STRIKE_MAX=5

# Database Configuration
DB_POOL_SIZE=20
DB_CONNECTION_TIMEOUT=30000
DB_QUERY_TIMEOUT=10000

# Real-time Configuration
REALTIME_HEARTBEAT_INTERVAL=30000
REALTIME_RECONNECT_DELAY=5000
REALTIME_MAX_RECONNECT_ATTEMPTS=10
REALTIME_SUBSCRIPTION_TIMEOUT=600000

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000
REDIS_URL=redis://username:password@host:port/0

# Application URLs
PRODUCTION_BUSINESS_URL=https://business.realtrack.app
PRODUCTION_CUSTOMER_URL=https://track.realtrack.app
STAGING_BUSINESS_URL=https://business-staging.realtrack.app
STAGING_CUSTOMER_URL=https://track-staging.realtrack.app
LOCAL_BUSINESS_URL=http://localhost:3000
LOCAL_CUSTOMER_URL=http://localhost:3001

# Business Rules
MAX_DRIVERS_PER_BUSINESS=50
MAX_DELIVERIES_PER_DRIVER_PER_DAY=20
MIN_RATING_FOR_PREMIUM_FEATURES=4.0
MAX_DELIVERY_RADIUS_KM=100

# Driver Configuration
DRIVER_LOCATION_UPDATE_INTERVAL_MS=15000
DRIVER_OFFLINE_TIMEOUT_MINUTES=5
DRIVER_MIN_RATING_FOR_TRUSTED=3.0

# Customer Configuration
CUSTOMER_TRACKING_RETENTION_DAYS=30
CUSTOMER_LOCATION_HISTORY_RETENTION_HOURS=24
CUSTOMER_MAX_ACTIVE_TRACKING_SESSIONS=5

# Notification Configuration
PUSH_NOTIFICATION_SERVICE=firebase
EMAIL_SERVICE_PROVIDER=sendgrid
EMAIL_FROM_ADDRESS=noreply@realtrack.app
SMS_SERVICE_PROVIDER=twilio
SMS_FROM_NUMBER=+1234567890

# Logging Configuration
LOG_LEVEL=info
LOG_FORMAT=json
LOG_MAX_FILE_SIZE_MB=100
LOG_RETENTION_DAYS=30

# Performance Thresholds
API_RESPONSE_TIME_WARNING_MS=1000
API_RESPONSE_TIME_CRITICAL_MS=5000
DB_QUERY_TIME_WARNING_MS=2000
DB_QUERY_TIME_CRITICAL_MS=10000
WEBSOCKET_CONNECTION_WARNING_THRESHOLD=100
WEBSOCKET_CONNECTION_CRITICAL_THRESHOLD=500

# Cost Optimization
CLEANUP_OLD_DATA_DAYS=90
COMPRESS_OLD_DATA_DAYS=30
ARCHIVE_OLD_DATA_DAYS=365

# Development Override (only for local development)
NODE_ENV=development
DEBUG_REALTIME=true
SKIP_RATE_LIMITING=true
MOCK_EXTERNAL_APIS=false