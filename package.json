{
  "name": "realtrack",
  "version": "1.0.0",
  "description": "Real-time delivery tracking platform for businesses and customers",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:business": "npm run dev --workspace=realtrack-business-portal",
    "dev:customer": "npm run dev --workspace=realtrack-customer-tracking",
    "dev:all": "concurrently \"npm run dev:business\" \"npm run dev:customer\"",
    "build:business": "npm run build --workspace=realtrack-business-portal",
    "build:customer": "npm run build --workspace=realtrack-customer-tracking",
    "build:all": "npm run build:business && npm run build:customer",
    "build:types": "npm run build --workspace=@realtrack/types",
    "build:realtime": "npm run build --workspace=@realtrack/realtime-service",
    "start:business": "npm run start --workspace=realtrack-business-portal",
    "start:customer": "npm run start --workspace=realtrack-customer-tracking",
    "lint": "npm run lint --workspaces",
    "lint:all": "npm run lint --workspaces && npm run lint --workspace=@realtrack/realtime-service",
    "lint:fix": "npm run lint --workspaces -- --fix",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "type-check": "npm run type-check --workspaces",
    "type-check:all": "npm run type-check --workspaces && npm run type-check --workspace=@realtrack/realtime-service",
    "test": "npm run test --workspaces",
    "test:coverage": "npm run test --workspaces -- --coverage",
    "test:integration": "jest --config=tests/integration/jest.config.js",
    "test:api": "jest --config=tests/api/jest.config.js",
    "test:database": "jest --config=tests/database/jest.config.js",
    "test:e2e": "playwright test",
    "test:e2e:business": "cd apps/business && npx playwright test",
    "test:e2e:customer": "cd apps/customer && npx playwright test",
    "test:performance": "lhci autorun",
    "test:security": "npm audit --audit-level=moderate --workspaces",
    "clean": "npm run clean --workspaces && rm -rf node_modules",
    "clean:all": "npm run clean --workspaces && rm -rf node_modules apps/*/node_modules packages/*/node_modules",
    "db:start": "docker-compose up -d",
    "db:stop": "docker-compose down",
    "db:reset": "docker-compose down -v && docker-compose up -d",
    "db:logs": "docker-compose logs -f",
    "db:migrate": "cd supabase && supabase db push",
    "db:seed": "cd supabase && psql \"$DATABASE_URL\" -f seed.sql && psql \"$DATABASE_URL\" -f enhanced_driver_seed.sql",
    "db:validate": "cd supabase && supabase db lint && supabase test db",
    "flutter:build": "cd apps/driver && flutter pub get && flutter build apk --release",
    "flutter:test": "cd apps/driver && flutter test",
    "flutter:analyze": "cd apps/driver && flutter analyze",
    "setup": "npm install && npm run build:types && npm run build:realtime && npm run db:start",
    "setup:dev": "cp .env.example .env && npm run setup",
    "setup:ci": "npm ci && npm run build:all && npm run flutter:build",
    "deploy:staging": "npm run build:all && npm run deploy:business:staging && npm run deploy:customer:staging",
    "deploy:production": "npm run build:all && npm run deploy:business:production && npm run deploy:customer:production",
    "deploy:business:staging": "cd apps/business && vercel --env=staging",
    "deploy:business:production": "cd apps/business && vercel --prod",
    "deploy:customer:staging": "cd apps/customer && vercel --env=staging", 
    "deploy:customer:production": "cd apps/customer && vercel --prod",
    "ci:lint": "npm run lint:all",
    "ci:test": "npm run test:coverage && npm run test:integration && npm run flutter:test",
    "ci:security": "npm run test:security",
    "ci:build": "npm run build:all",
    "ci:e2e": "npm run test:e2e:business && npm run test:e2e:customer",
    "ci:quality": "npm run ci:lint && npm run ci:test && npm run ci:security && npm run ci:build",
    "health-check": "curl -f $BUSINESS_URL && curl -f $CUSTOMER_URL || exit 1",
    "monitor:deploy": "curl -X POST $MONITORING_WEBHOOK_URL -H 'Content-Type: application/json' -d '{\"event\": \"deployed\", \"version\": \"'$VERSION'\"}'"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "@types/node": "^20.8.0",
    "typescript": "^5.2.2",
    "prettier": "^3.0.3",
    "eslint": "^8.51.0",
    "jest": "^29.7.0",
    "@playwright/test": "^1.40.0",
    "@lhci/cli": "^0.12.0",
    "artillery": "^2.0.0",
    "audit-ci": "^6.6.1",
    "codecov": "^3.8.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "delivery",
    "tracking",
    "real-time",
    "logistics",
    "supabase",
    "nextjs",
    "flutter",
    "saas",
    "multi-tenant"
  ],
  "author": "RealTrack Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/sen6eii/realtrack.git"
  },
  "bugs": {
    "url": "https://github.com/sen6eii/realtrack/issues"
  },
  "homepage": "https://github.com/sen6eii/realtrack#readme"
}